# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Envío del formulario de contacto vía Gmail con OAuth2 (nodemailer).
# El refresh token se genera con: node scripts/getRefreshToken.js
EMAIL_USER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
EMAIL_TO=

# "true" muestra la página de mantenimiento en todo el sitio (middleware).
# En Vercel: activo en producción (main), apagado en previews (develop).
MAINTENANCE_MODE=
